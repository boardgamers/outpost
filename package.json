{
	"name": "outpost",
	"version": "0.0.0",
	"private": true,
	"description": "Unofficial open-source implementation of the board game Outpost for boardgamers.space (engine + viewer)",
	"license": "AGPL-3.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter outpost-viewer dev",
		"build": "pnpm --filter outpost-engine build && pnpm --filter outpost-viewer build",
		"test": "pnpm --filter outpost-engine test && pnpm test:tutorial",
		"tsc": "pnpm --filter outpost-engine tsc && pnpm --filter outpost-viewer tsc",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"check": "pnpm test:locales && pnpm fmt:check && pnpm lint && pnpm tsc && pnpm test && pnpm build",
		"test:browser": "node tests/protocol-smoke.mjs",
		"test:selection": "node tests/card-selection-browser.mjs",
		"test:tutorial": "pnpm --filter outpost-engine build && node --test tests/tutorial.spec.mjs",
		"test:tutorial:browser": "node tests/tutorial-browser.mjs",
		"preview:tutorial": "node tests/tutorial-preview.mjs",
		"test:locales": "node scripts/check-locales.mjs packages/viewer/src/localization && node --test scripts/localization.test.mjs",
		"test:scroll": "node tests/mobile-scroll.mjs",
		"test:bulk": "node tests/bulk-purchase-browser.mjs"
	},
	"devDependencies": {
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"playwright": "1.62.1",
		"svelte": "5.56.8"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.11.0"
}
